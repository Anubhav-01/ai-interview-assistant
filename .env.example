# ============================================================
# AI Interview Assistant - Environment Configuration
# ------------------------------------------------------------
# Copy this file to `.env` and fill in your own API keys.
# NEVER commit your real `.env` file to Git.
#
# You can also configure everything from the in-app Settings
# screen instead of using this file. Values entered in the app
# take priority over this file.
# ============================================================

# AI provider: openai | gemini | mock
# "mock" works fully offline without any API key (for testing/demo).
AI_PROVIDER=mock

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Speech provider: whisper | browser | mock
# "whisper" uses the OpenAI Whisper API (requires OPENAI_API_KEY).
SPEECH_PROVIDER=mock
